# Keep the build context small — it is sent to the daemon on every build.

.git/
.github/
.claude/

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tests, CI helpers and the design sources are not part of a running
# container. scripts/smoke_container.py drives the container from outside it.
tests/
scripts/
google_stich/

# Solver output and run-time temp files: bind-mounted at run time, never baked in.
results/*
!results/.gitkeep
params/_run_*.json

# Machine-specific, and written at run time.
settings.json

# The CLI's matplotlib dependency is not installed in the image, so neither is
# the plotting entry point.
plot_results.py

# Desktop leftovers and docs the container does not serve.
icon.png
icon.ico
CLAUDE.md
Dockerfile
docker-compose.yml
.dockerignore
